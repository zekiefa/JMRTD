<project>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jmrtd</groupId>
    <artifactId>jmrtd-parent</artifactId>
    <version>0.5.2</version>
  </parent>
  <artifactId>jj2000_imageio</artifactId>
  <name>JJ2000 ImageIO</name>
  <description>JPEG 2000 image I/O adapter for ImageIO using JJ2000.</description>
<dependencies>
    <dependency>
      <groupId>edu.ucar</groupId>
      <artifactId>jj2000</artifactId>
      <version>5.2</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.45</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <!-- JJ2000 encoder/decoder depend on runtime state PIT minions mis-handle (empty cs). Track follow-up in issue jmrtd-ugi remains open until upstream lib debugged. -->
          <excludedTestClasses>
            <param>org.jmrtd.imageio.JJ2000ImageIOTest</param>
            <param>org.jmrtd.jj2000.JJ2000RoundTripTest</param>
          </excludedTestClasses>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
